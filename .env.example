# Settings for ubuntu_lab_install.sh. Copy to .env next to the script and edit:
#   cp .env.example .env && chmod 600 .env
# .env is gitignored. Never commit a real password.
# A value set in the shell environment wins over this file.
# Write KEY=value only: no quotes, and no comment after a value.

# Required. gnome = lab computers (class, exam). xfce = csmajor room public computers.
DESKTOP=gnome

# Admin account with sudo that runs this script. SSH is restricted to this account.
SUDOER_ACCOUNT=cscmu

# Restricted no-sudo account. Leave empty for the default: student on gnome, csmajor on xfce.
STUDENT_ACCOUNT=

# Password set when this script has to create the account. Leave empty to lock password login.
STUDENT_PASSWORD=
